EAPI=8

PYTHON_COMPAT=( python3_{9..12} )
DISTUTILS_USE_PEP517=setuptools

inherit distutils-r1

DESCRIPTION="Framework for Universal Gravitational Observation & Research Analysis (Project U17267)"
HOMEPAGE="https://github.com/CornelI5/U17267-Fugora"
SRC_URI="https://github.com/CornelI5/U17267-Fugora/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz"

LICENSE="MIT"
SLOT="0"
KEYWORDS="~amd64 ~x86"

RDEPEND="
    dev-python/numpy[${PYTHON_USEDEP}]
    dev-python/pyyaml[${PYTHON_USEDEP}]
    dev-python/requests[${PYTHON_USEDEP}]
    dev-python/pygame[${PYTHON_USEDEP}]
"

DEPEND="${RDEPEND}"

src_prepare() {
    default
    if [ ! -f setup.py ]; then
        die "setup.py not found!"
    fi
}

python_install_all() {
    distutils-r1_python_install_all
}
